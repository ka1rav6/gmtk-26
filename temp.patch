From acfd31da7a376168d68e1a929df8bb70af47b271 Mon Sep 17 00:00:00 2001
From: ka1rav6 <kairavdutta@gmail.com>
Date: Fri, 24 Jul 2026 19:22:19 +0000
Subject: [PATCH] Add Restart and How to Play buttons to start/pause menus

- Global.gd: shared reset_state/start_level/restart_current_level helpers
- New shared HowToPlayOverlay scene/script, instanced in both menus
- PauseMenu/StartMenu: add Restart + How to Play buttons, re-spaced layout
- Player.tscn: reparent PauseMenu to level root on death so Restart stays
  reachable after game over instead of being freed with the player
---
 scenes/characters/player/Player.tscn |  8 +++
 scenes/global.gd                     | 24 ++++++++
 scenes/ui/HowToPlayOverlay.tscn      | 87 ++++++++++++++++++++++++++++
 scenes/ui/PauseMenu.tscn             | 39 +++++++++++--
 scenes/ui/StartMenu.tscn             | 47 +++++++++++----
 scenes/ui/how_to_play_overlay.gd     | 29 ++++++++++
 scenes/ui/pause_menu.gd              | 27 +++++++++
 scenes/ui/start_menu.gd              | 29 +++++++++-
 8 files changed, 273 insertions(+), 17 deletions(-)
 create mode 100644 scenes/ui/HowToPlayOverlay.tscn
 create mode 100644 scenes/ui/how_to_play_overlay.gd

diff --git a/scenes/characters/player/Player.tscn b/scenes/characters/player/Player.tscn
index b0ed25d..a83435e 100644
--- a/scenes/characters/player/Player.tscn
+++ b/scenes/characters/player/Player.tscn
@@ -41,6 +41,14 @@ func set_speed(mult: float) -> void:
 func take_damage(amount: int) -> void:
 	health -= amount
 	if health <= 0:
+		# PauseMenu lives under the player normally; reparent it to the level
+		# root first so it (and its Restart button) survive the player dying,
+		# instead of getting freed along with us.
+		var menu := get_node_or_null(\"PauseMenu\")
+		if menu:
+			menu.reparent(get_tree().current_scene)
+			menu.visible = true
+			get_tree().paused = true
 		queue_free()
 
 func _physics_process(delta: float) -> void:
diff --git a/scenes/global.gd b/scenes/global.gd
index 2bb4b7c..1467c2f 100644
--- a/scenes/global.gd
+++ b/scenes/global.gd
@@ -23,6 +23,30 @@ func _process(_delta: float) -> void:
 func refresh_player() -> void:
 	if not is_instance_valid(player):
 		player = get_tree().get_first_node_in_group("Player")
+
+# Resets every piece of persistent state Global tracks. Scene-local state
+# (player, enemies, collectibles, timers, etc.) lives in the level scene
+# itself, so reloading/swapping that scene resets it for free — this only
+# has to clean up what actually survives a scene change.
+func reset_state() -> void:
+	score = 0
+	powerMode = false
+	enemy_count = 0
+	player = null
+
+# Used by both the start menu and the pause menu so "Start" and "Restart"
+# never fall out of sync with each other.
+func start_level(level_scene: PackedScene) -> void:
+	reset_state()
+	get_tree().paused = false
+	get_tree().change_scene_to_packed(level_scene)
+
+# Restarts whatever level is currently running, fresh, regardless of
+# whether it's paused or the player has already died.
+func restart_current_level() -> void:
+	reset_state()
+	get_tree().paused = false
+	get_tree().reload_current_scene()
 		
 func toggle_all() -> void:
 	refresh_player()
